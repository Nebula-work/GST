# Backend environment variables.
# These are read directly from the process environment (os.getenv) — set them
# on your host / platform (App Runner, EC2 systemd, Render, docker -e, etc.).
# The app does NOT auto-load this file; it's documentation only.

# Allowed CORS origins for the frontend — comma-separated, no trailing slash.
# Unset or "*" allows any origin (fine for local dev; lock it down in prod).
# Example for AWS Amplify + a custom domain:
CORS_ALLOW_ORIGINS=https://main.d1234abcd.amplifyapp.com,https://gst.example.com

# Optional regex for wildcard hosts (e.g. Amplify branch/preview URLs).
# Useful when each branch gets its own *.amplifyapp.com subdomain.
# CORS_ALLOW_ORIGIN_REGEX=https://.*\.amplifyapp\.com
