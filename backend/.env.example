# Backend environment variables.
# These are read directly from the process environment (os.getenv) — set them
# on your host / platform (App Runner, EC2 systemd, Render, docker -e, etc.).
# The app does NOT auto-load this file; it's documentation only.

# Allowed CORS origins for the frontend — comma-separated, no trailing slash.
# Unset or "*" allows any origin (fine for local dev; lock it down in prod).
# Example for AWS Amplify + a custom domain:
CORS_ALLOW_ORIGINS=https://main.d1234abcd.amplifyapp.com,https://gst.example.com

# Optional regex for wildcard hosts (e.g. Amplify branch/preview URLs).
# Useful when each branch gets its own *.amplifyapp.com subdomain.
# CORS_ALLOW_ORIGIN_REGEX=https://.*\.amplifyapp\.com

# --- Abuse / resource limits (all optional; safe defaults are built in) ------
# The API is public and unauthenticated, so it self-limits. Override per host.

# Per-file and combined upload size caps (bytes). Default: 15 MB / ~31 MB.
# MAX_UPLOAD_BYTES=15728640
# MAX_TOTAL_UPLOAD_BYTES=32505856

# Per-client rate limit: at most N requests per window (seconds). Default 20/60s.
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW_SECONDS=60

# Max reconciles processed at once (others get HTTP 503). Default 2.
# MAX_CONCURRENT_RECONCILES=2

# Hard wall-clock budget for one reconcile (seconds) before it's abandoned. Default 30.
# RECONCILE_TIMEOUT_SECONDS=30

# Max allowed value for the per-request 'tolerance' field (rupees). Default 1000.
# MAX_TOLERANCE=1000

# Trust nginx's forwarded client IP (X-Real-IP / X-Forwarded-For) for rate
# limiting. Default true (we run behind nginx). Set false if exposed directly,
# so clients can't spoof their IP to bypass the limiter.
# TRUST_PROXY=true

# Cloudflare Turnstile SECRET key. SET THIS ON THE SERVER (never commit it).
# When set, /api/reconcile requires a valid Turnstile token (the frontend sends
# one via the public site key, NEXT_PUBLIC_TURNSTILE_SITE_KEY). Unset = disabled.
# TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret
