# Base URL of the FastAPI backend.
# Optional — the app falls back to http://localhost:8011 if this is unset.
# Copy to .env.local to override (e.g. if you run the backend on another port).
NEXT_PUBLIC_API_BASE=http://localhost:8011

# Cloudflare Turnstile PUBLIC site key (baked into the build; safe to commit).
# When set, the bot-check widget renders and a token is sent with each reconcile.
# Leave unset for local dev to disable the widget. Must also set the backend's
# TURNSTILE_SECRET_KEY for verification to be enforced.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADpj-1bDTbRNjFDD

# Set to 1 by desktop/scripts/build-frontend.mjs when building the Electron
# app. Drops the Turnstile widget and the Cloudflare beacon from the export and
# lets the UI take the backend URL from the Electron shell at runtime.
# Leave unset for the web build.
# NEXT_PUBLIC_DESKTOP=1
